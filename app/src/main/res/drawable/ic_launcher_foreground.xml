<?xml version="1.0" encoding="utf-8"?>
<!--
    A shield with a key in it. Everything stays inside the centre 66 x 66 area of the 108 x 108
    canvas, the part Android never crops, whatever shape the launcher uses (circle, squircle...).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The shield -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,26 L78,34 L78,52 C78,66 68,76 54,82 C40,76 30,66 30,52 L30,34 Z" />

    <!-- Teal edge inside the shield -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,30.5 L74,37 L74,52 C74,63.5 66,72 54,77.5 C42,72 34,63.5 34,52 L34,37 Z"
        android:strokeWidth="1.6"
        android:strokeColor="#00796B" />

    <!-- The key: a ring with a hole (even-odd), a shaft and two teeth -->
    <path
        android:fillColor="#0B2A4A"
        android:fillType="evenOdd"
        android:pathData="M54,38 a8,8 0 1,1 0,16 a8,8 0 1,1 0,-16 z M54,42 a4,4 0 1,0 0,8 a4,4 0 1,0 0,-8 z" />
    <path
        android:fillColor="#0B2A4A"
        android:pathData="M52,53 L56,53 L56,72 L52,72 Z M56,62 L62,62 L62,65 L56,65 Z M56,67.5 L61,67.5 L61,70.5 L56,70.5 Z" />
</vector>
